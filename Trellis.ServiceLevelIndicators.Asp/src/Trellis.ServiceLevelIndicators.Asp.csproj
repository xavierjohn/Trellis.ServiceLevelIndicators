<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <RootNamespace>Trellis.ServiceLevelIndicators</RootNamespace>
        <Description>ASP.NET Core middleware for emitting Service Level Indicator (SLI) latency metrics in milliseconds for MVC and Minimal API endpoints. Supports endpoint exclusions, service-specific dimensions, configurable HTTP outcomes, abort telemetry, and opt-in latency threshold counts.</Description>
        <PackageTags>sli;slo;aspnetcore;middleware;opentelemetry;metrics;observability;telemetry;trellis</PackageTags>
        <TrellisApiRefName>sli-asp</TrellisApiRefName>
        <TrellisApiRefDescription>Open when configuring ASP.NET Core SLI middleware, endpoint exclusions, MVC/Minimal API dimensions, HTTP classifiers, request-abort telemetry, or cancellation-safe enrichment.</TrellisApiRefDescription>
    </PropertyGroup>
    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Trellis.AgentDocs.Packaging" PrivateAssets="all" />
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\Trellis.ServiceLevelIndicators\src\Trellis.ServiceLevelIndicators.csproj" />
    </ItemGroup>
</Project>
