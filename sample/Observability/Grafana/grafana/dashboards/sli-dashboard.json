      "pluginVersion": "11.6.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (le, Operation) (rate(operation_duration_milliseconds_bucket{Operation=~\"$operation\",CustomerResourceId=~\"$customer\",LocationId=~\"$location\"}[$__rate_interval])))",
          "legendFormat": "p50 {{Operation}}",
          "range": true,
          "refId": "A"
