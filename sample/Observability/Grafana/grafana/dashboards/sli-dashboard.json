      "description": "Approximate histogram percentiles across all outcomes, for diagnosis. The 250 ms line is a reference; the exact latency SLI is the Within 250 ms panel.",
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "hideZeros": false,
          "mode": "multi",
          "sort": "desc"
