      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "100 * (sum(rate(operation_duration_threshold_count_total{Operation=~\"$operation\",CustomerResourceId=~\"$customer\",LocationId=~\"$location\",Outcome=~\"Success|Failure\",sli_latency_threshold_ms=\"250\",sli_latency_result=\"within\"}[$__rate_interval])) or vector(0)) / (sum(rate(operation_duration_threshold_count_total{Operation=~\"$operation\",CustomerResourceId=~\"$customer\",LocationId=~\"$location\",Outcome=~\"Success|Failure\",sli_latency_threshold_ms=\"250\"}[$__rate_interval])) > 0)",
          "legendFormat": "within 250 ms",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Within 250 ms (objective: >= 99%)",
      "type": "stat"
    },
