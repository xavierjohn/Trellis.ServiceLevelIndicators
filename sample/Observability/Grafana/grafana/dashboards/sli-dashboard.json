          "expr": "histogram_quantile(0.99, sum by (le, Operation) (rate(operation_duration_milliseconds_bucket{Operation=~\"$operation\",CustomerResourceId=~\"$customer\",LocationId=~\"$location\"}[$__rate_interval])))",
          "hide": false,
